# ==============================================================================
# RESQ-AI BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-resq-ai-master-key-hackathon-chennai-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://localhost:5432/resq_ai

# AI & LLM Extraction Engine
# Options: "openai" | "local_mock"
AI_PROVIDER=openai

# API Key & Endpoint (Supports OpenAI sk-proj-... or OpenRouter sk-or-v1-...)
# Note: If no key is provided, the backend automatically uses LocalMockProvider.
OPENAI_API_KEY=sk-or-v1-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Weather API Configuration (OpenWeatherMap - Optional)
# Note: If no key is provided, the backend uses simulated monsoon telemetry.
WEATHER_API_KEY=your_openweathermap_api_key_here

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Port
PORT=8000
