# Weather API Configuration (OpenWeatherMap)
WEATHER_API_KEY=9d01f228f9aa69130803b730b1d95034

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Port
PORT=8000
